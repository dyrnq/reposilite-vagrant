{
    "authentication": {
        "ldap": {
            "enabled": false,
            "ssl": false,
            "hostname": "ldap.domain.com",
            "port": 389,
            "baseDn": "dc=company,dc=com",
            "searchUserDn": "cn=reposilite,ou=admins,dc=domain,dc=com",
            "searchUserPassword": "reposilite-admin-secret",
            "typeAttribute": "person",
            "userAttribute": "cn",
            "userFilter": "(&(objectClass=person)(ou=Maven Users))",
            "userType": "PERSISTENT"
        }
    },
    "frontend": {
        "id": "reposilite-repository",
        "title": "Reposilite Repository",
        "description": "Public Maven repository hosted through the Reposilite",
        "organizationWebsite": "https://reposilite.com",
        "organizationLogo": "https://avatars.githubusercontent.com/u/88636591",
        "icpLicense": ""
    },
    "maven": {
        "repositories": [
            {
                "id": "releases",
                "visibility": "PUBLIC",
                "redeployment": true,
                "preserveSnapshots": true,
                "storageProvider": {
                    "type": "fs",
                    "quota": "100%",
                    "mount": "",
                    "maxResourceLockLifetimeInSeconds": 60
                },
                "storagePolicy": "PRIORITIZE_UPSTREAM_METADATA",
                "metadataMaxAge": 0,
                "proxied": []
            },
            {
                "id": "snapshots",
                "visibility": "PUBLIC",
                "redeployment": true,
                "preserveSnapshots": true,
                "storageProvider": {
                    "type": "fs",
                    "quota": "100%",
                    "mount": "",
                    "maxResourceLockLifetimeInSeconds": 60
                },
                "storagePolicy": "PRIORITIZE_UPSTREAM_METADATA",
                "metadataMaxAge": 0,
                "proxied": []
            },
            {
                "id": "private",
                "visibility": "PRIVATE",
                "redeployment": true,
                "preserveSnapshots": true,
                "storageProvider": {
                    "type": "fs",
                    "quota": "100%",
                    "mount": "",
                    "maxResourceLockLifetimeInSeconds": 60
                },
                "storagePolicy": "PRIORITIZE_UPSTREAM_METADATA",
                "metadataMaxAge": 0,
                "proxied": []
            },
            {
                "id": "s3",
                "visibility": "PUBLIC",
                "redeployment": true,
                "preserveSnapshots": true,
                "storageProvider": {
                    "type": "s3",
                    "bucketName": "reposilite",
                    "endpoint": "http://192.168.111.10:9000",
                    "accessKey": "accessKey",
                    "secretKey": "secretKey",
                    "region": ""
                },
                "storagePolicy": "PRIORITIZE_UPSTREAM_METADATA",
                "metadataMaxAge": 0,
                "proxied": []
            }
        ]
    },
    "statistics": {
        "enabled": true,
        "resolvedRequestsInterval": "MONTHLY"
    },
    "web": {
        "forwardedIp": "X-Forwarded-For"
    }
}